# .env.example
# 변경이력: v1.0.0 | 2026-04-07 | [Implementer] | 최초 생성

# ===== SIP ACL (FS-1: mod_acl) =====
# Restrict inbound SIP INVITE to PBX/SBC IPs only
# Dev default: 0.0.0.0/0 (allow all). Production: MUST set exact PBX IPs!
# Example: PBX_ACL_IP1=10.10.1.100/32
PBX_ACL_IP1=0.0.0.0/0
PBX_ACL_IP2=0.0.0.0/0

# ===== SIP =====
SIP_PORT=5060
SIP_TLS_PORT=5061
SIP_TLS_ONLY=false
SIP_TLS_CERT_DIR=/etc/freeswitch/tls
SRTP_MODE=optional

# ===== NAT (S-04) =====
# Same network / dedicated line: auto-nat works fine
# Behind NAT / firewall: MUST set public IP to prevent one-way audio!
#   Find your public IP: curl ifconfig.me
# Example: EXTERNAL_RTP_IP=203.0.113.10
EXTERNAL_RTP_IP=<set-to-host-routable-ip>
EXTERNAL_SIP_IP=<set-to-host-routable-ip>
# macOS Docker softphone dev: use INTERNAL_LOCAL_NETWORK_ACL=vbgw-localnet so FreeSWITCH
# advertises the host-routable external media IP instead of the container bridge IP.
INTERNAL_LOCAL_NETWORK_ACL=localnet.auto
VBGW_LOCALNET_CIDR=127.0.0.0/8
STUN_ENABLED=true

# ===== Session =====
# P-13: false recommended unless PBX explicitly requires 100rel
PRACK_ENABLED=false
SESSION_TIMER_ENABLED=true
# T-22: Default 1800 (30min) matches vars.xml. Set 0 to disable forced hangup.
SESSION_TIMEOUT=1800
MIN_SE=90
ANSWER_DELAY_MS=200

# ===== RTP =====
# T-23: Default 16584 matches docker-compose/vars.xml (200 ports = 100 concurrent calls).
# Increase to 32768 (16384 ports) only if you need 8000+ concurrent calls.
RTP_PORT_MIN=16384
RTP_PORT_MAX=16584

# ===== Jitter Buffer (P-10) =====
# Dedicated line/VPN (low jitter): 40:20:100
# Internet (high jitter):          100:60:300
# Default (moderate):              60:20:200
JB_INIT_MS=60
JB_MIN_MS=20
JB_MAX_MS=200

# ===== PBX / SBC Interconnect =====
# false: disable external PBX/SBC interconnect monitoring and gateway generation
PBX_INTERCONNECT_ENABLED=false

# Register mode: true  -> REGISTER-based gateway
# Trunk mode:    false -> static peer/trunk (registerless gateway)
PBX_MAIN_REGISTER=true
PBX_MAIN_GATEWAY=pbx-main
PBX_MAIN_PROXY=
PBX_MAIN_REALM=
PBX_MAIN_USERNAME=
PBX_MAIN_PASSWORD=
PBX_MAIN_EXTENSION=
PBX_MAIN_FROM_USER=
PBX_MAIN_FROM_DOMAIN=
PBX_MAIN_REGISTER_PROXY=
PBX_MAIN_REGISTER_TRANSPORT=udp
PBX_MAIN_PING_SECONDS=25

# ===== PBX Standby (P-11: failover) =====
PBX_STANDBY_ENABLED=false
PBX_STANDBY_REGISTER=true
PBX_STANDBY_GATEWAY=pbx-standby
PBX_STANDBY_PROXY=
PBX_STANDBY_REALM=
PBX_STANDBY_USERNAME=
PBX_STANDBY_PASSWORD=
PBX_STANDBY_EXTENSION=
PBX_STANDBY_FROM_USER=
PBX_STANDBY_FROM_DOMAIN=
PBX_STANDBY_REGISTER_PROXY=
PBX_STANDBY_REGISTER_TRANSPORT=udp
PBX_STANDBY_PING_SECONDS=25
PBX_PROBE_INTERVAL_SECONDS=30
PBX_HEALTH_TTL_SECONDS=90
PBX_FAIL_FAST_ON_STALE=true

# ===== ESL =====
ESL_HOST=127.0.0.1
ESL_PORT=8021
# ===== IVR (R-07) =====
# DTMF '0' → 상담원 전환 대상 (예: 1000@pbx, agent_queue)
# 비어있으면 전환 기능 비활성화 (로그 경고만)
IVR_TRANSFER_TARGET=

# ===== Codec (P-05) =====
# PBX compatibility: G.711 first (default). For Opus-capable PBX: opus@48000h@20i,G722,PCMU,PCMA
INBOUND_CODEC_PREFS=PCMU@8000h@20i,PCMA@8000h@20i,G722@16000h@20i,opus@48000h@20i
OUTBOUND_CODEC_PREFS=PCMU@8000h@20i,PCMA@8000h@20i,G722@16000h@20i,opus@48000h@20i
AUDIO_FORK_SCHEME=ws

# ===== ESL =====
# MUST change from default — generate with: openssl rand -hex 16
ESL_PASSWORD=<your-strong-esl-password>

# ===== HTTP API =====
HTTP_PORT=8080
# MUST change — generate with: openssl rand -hex 32
ADMIN_API_KEY=<generate-with-openssl-rand-hex-32>
# MUST change — generate with: openssl rand -hex 32
ADMIN_CONTROL_KEY=<generate-with-openssl-rand-hex-32>
# MUST change — generate with: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>
# MUST change — generate with: openssl rand -hex 32
INTERNAL_API_SECRET=<generate-with-openssl-rand-hex-32>
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# ===== Session =====
MAX_SESSIONS=100
REDIS_ADDR=vbgw-redis:16379

# ===== AI Engine =====
AI_GRPC_ADDR=127.0.0.1:50051
AI_GRPC_TLS=false

# ===== Bridge =====
BRIDGE_HOST=127.0.0.1
BRIDGE_WS_PORT=8090
BRIDGE_INTERNAL_PORT=8091
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== VAD =====
ONNX_MODEL_PATH=/models/silero_vad.onnx

# ===== gRPC Retry =====
GRPC_MAX_RETRIES=5
GRPC_MAX_BACKOFF_MS=4000
# T-28: 2h default (prevents zombie gRPC streams). Max = longest expected call * 1.5
GRPC_STREAM_DEADLINE_SECS=7200

# ===== Dynamic AI Dialplan =====
ROUTING_CONFIG_PATH=/app/config/routing.yaml
AI_ROUTE_NUMBERS=9196
SLOT_REGISTRATION_REFRESH_MS=5000
SLOT_REGISTRATION_TTL_SECONDS=30
OVERFLOW_QUEUE_TICK_MS=1000
HUMAN_FALLBACK_ENABLED=true
DISTRIBUTED_QUEUE_CLAIM_TTL_MS=3000
DISTRIBUTED_QUEUE_SCAN_LIMIT=8
NODE_ID=vbgw-orchestrator
ORCHESTRATOR_VERSION=7.0.0
LEASE_SCHEMA_VERSION=1
CLUSTER_HEARTBEAT_INTERVAL_MS=2000
CLUSTER_HEARTBEAT_TTL_MS=8000
CLUSTER_REAPER_INTERVAL_MS=5000
CLUSTER_LEASE_TTL_MS=15000
CLUSTER_LEASE_STALE_GRACE_MS=10000

# ===== Recording =====
RECORDING_ENABLE=false
RECORDING_DIR=/recordings
RECORDING_MAX_DAYS=30
RECORDING_MAX_MB=1024

# ===== Runtime =====
RUNTIME_PROFILE=production
LOG_LEVEL=info
