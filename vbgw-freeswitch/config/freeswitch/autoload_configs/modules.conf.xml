<configuration name="modules.conf" description="Modules">
  <modules>
    <!-- Loggers -->
    <load module="mod_console"/>
    <load module="mod_logfile"/>
    <load module="mod_syslog"/>

    <!-- Event Handlers -->
    <load module="mod_event_socket"/>

    <!-- Endpoints -->
    <load module="mod_sofia"/>
    <load module="mod_rtc"/>
    <load module="mod_loopback"/>

    <!-- Applications -->
    <load module="mod_commands"/>
    <load module="mod_conference"/>
    <load module="mod_callcenter"/>
    <load module="mod_dptools"/>
    <load module="mod_httapi"/>
    <load module="mod_shout"/>
    <load module="mod_avmd"/>
    <load module="mod_vad_detect"/>
    <load module="mod_vad_silero"/>

    <!-- Dialplan Interfaces -->
    <load module="mod_dialplan_xml"/>
    <load module="mod_xml_curl"/>

    <!-- Codecs -->
    <load module="mod_opus"/>
    <load module="mod_opusfile"/>
    <load module="mod_sndfile"/>
    <load module="mod_native_file"/>
    <load module="mod_g723_1"/>
    <load module="mod_g729"/>
    <load module="mod_h26x"/>
    <load module="mod_amr"/>

    <!-- Timers -->
    <load module="mod_timerfd"/>

    <!-- Languages -->
    <load module="mod_say_en"/>

    <!-- AI & Transcription (Drachtio Special) -->
    <load module="mod_audio_fork"/>
    <load module="mod_google_tts"/>
    <load module="mod_google_transcribe"/>
    <load module="mod_google_tts_streaming"/>
    <load module="mod_google_s2s"/>
    <load module="mod_google_tts_streaming"/>

    <!-- Formats -->
    <load module="mod_local_stream"/>
    <load module="mod_tone_stream"/>
  </modules>
</configuration>
